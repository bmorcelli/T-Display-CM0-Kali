# Normalize line endings for all text files to LF in the repo and on checkout.
# This project mixes Windows-authored sources with Linux/embedded scripts,
# kernel drivers and device resources that must stay LF.
* text=auto eol=lf

# Windows-specific scripts keep CRLF
*.bat text eol=crlf

# Binary files - never touch line endings
*.ko binary
*.dtbo binary
*.o binary
*.out binary
*.png binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.pdf binary
*.wav binary
*.swp binary
